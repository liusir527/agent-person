{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "runtime/req/state.json 权威 schema",
  "description": "需求开发状态机单条需求单的状态文件。脚本 requirement_state_machine.py 按此结构读写。字段说明见各 property 注释。",
  "type": "object",
  "required": [
    "schema_version", "req_id", "jira_key", "title", "module",
    "created_at", "updated_at",
    "main_state", "micro_state", "review_round",
    "escalated", "human_takeover",
    "artifacts", "gates", "timeline", "review_rounds", "worklog", "jira", "git"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1, "description": "schema 版本，迁移时递增" },
    "req_id": { "type": "string", "description": "需求单号，目录名（如 NEWNF-54398 / REQ-1001）" },
    "jira_key": { "type": "string", "description": "JIRA 工单号，默认等于 req_id" },
    "title": { "type": "string", "description": "需求描述摘要" },
    "module": { "type": "string", "description": "【模块】标签，如 安全策略" },
    "created_at": { "type": "string", "format": "date-time", "description": "状态机创建时间（ISO8601 本地时区）" },
    "updated_at": { "type": "string", "format": "date-time", "description": "最近一次变更时间" },

    "main_state": { "type": "string", "enum": ["需求澄清", "需求分析", "方案评审", "出实施计划", "编码实现", "测试验证", "交付上线", "结束"], "description": "主状态机当前节点" },
    "micro_state": { "type": "string", "description": "主状态内部当前微观状态" },
    "review_round": { "type": "integer", "minimum": 0, "description": "已完成的评审轮次（0..3）" },
    "escalated": { "type": "boolean", "description": "评审 3 轮失败已升级" },
    "human_takeover": { "type": "boolean", "description": "已转人工接管" },

    "artifacts": {
      "type": "object",
      "description": "产物路径映射。analysis/design/plan/selftest 门禁按已知产物文件名查磁盘（见 ARTIFACT_FILES 常量）；conclusion 存 close 时 --conclusion 传入的路径（可能为 req 目录之外绝对路径）",
      "properties": {
        "analysis": { "type": "string", "description": "需求理解说明书.md" },
        "design": { "type": "string", "description": "需求设计说明书.md（advance 到方案评审时登记）" },
        "review": { "type": "string", "description": "最新一轮评审结果文件名" },
        "reviews": { "type": "array", "items": { "type": "string" }, "description": "全部轮次评审结果文件名" },
        "plan": { "type": "string", "description": "实施计划.md" },
        "selftest": { "type": "string", "description": "测试记录.md" },
        "pr_desc": { "type": "string", "description": "MR描述.md" },
        "conclusion": { "type": "string", "description": "交付说明.md" }
      }
    },

    "gates": {
      "type": "object",
      "description": "门禁布尔表。advance 到下一主状态前硬校验对应项为 true。人工确认门禁（requirement_confirmed/plan_confirmed/test_passed/mr_reviewed/merged）仅可由 confirm 命令置位；design_reviewed 仅由 review PASS 置位；code_reviewed/build_passed 置位须带证据文件，全部由 requirement_state_machine.py 强制执行",
      "properties": {
        "requirement_confirmed": { "type": "boolean", "description": "需求理解+验收标准已获需求方确认" },
        "design_reviewed": { "type": "boolean", "description": "设计方案经对抗评审 PASS（按验收标准可推演/可测试）" },
        "plan_confirmed": { "type": "boolean", "description": "实施计划经用户确认" },
        "worktree_ready": { "type": "boolean", "description": "编译机隔离 worktree 已派生并登记（仅 worktree-set 置位）" },
        "code_reviewed": { "type": "boolean", "description": "代码改动经 code-reviewer 审查 PASS（证据型）" },
        "build_passed": { "type": "boolean", "description": "编译通过（证据型）" },
        "test_handed": { "type": "boolean", "description": "已转人工验收" },
        "test_passed": { "type": "boolean", "description": "人工验收通过（受限环境可测项全过+交接项登记）" },
        "mr_reviewed": { "type": "boolean", "description": "MR 经人工 review" },
        "merged": { "type": "boolean", "description": "合并/部署上线完成" }
      }
    },

    "timeline": {
      "type": "array",
      "description": "事件流（断点恢复依据）",
      "items": {
        "type": "object",
        "required": ["at", "event", "main_state", "micro_state"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "event": { "type": "string" },
          "main_state": { "type": "string" },
          "micro_state": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },

    "review_rounds": {
      "type": "array",
      "description": "每轮评审记录",
      "items": {
        "type": "object",
        "required": ["round", "result", "reproduced", "issues", "artifact"],
        "properties": {
          "round": { "type": "integer" },
          "started_at": { "type": "string" },
          "ended_at": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL"] },
          "reproduced": { "type": "boolean", "description": "可推演成功（对应需求场景，字段名沿用 bug-fix 兼容）" },
          "issues": { "type": "string", "description": "阻塞点/建议补充方向（FAIL 时）" },
          "artifact": { "type": "string" }
        }
      }
    },

    "worklog": {
      "type": "object",
      "description": "工时记录。sync_mode 为 JIRA worklog 直写扩展点：local → jira_worklog",
      "properties": {
        "sync_mode": { "type": "string", "enum": ["local", "jira_worklog"], "description": "当前工时同步方式" },
        "local": {
          "type": "object",
          "properties": {
            "analysis": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "需求澄清+需求分析" },
            "review": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "方案评审" },
            "plan": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "出实施计划" },
            "coding": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "编码实现" },
            "test": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "测试验证" },
            "deliver": { "type": "object", "properties": { "minutes": { "type": "integer" }, "note": { "type": "string" } }, "description": "交付上线" }
          }
        },
        "total_minutes": { "type": "integer" },
        "jira_worklog_synced": { "type": "boolean" }
      }
    },

    "jira": {
      "type": "object",
      "description": "JIRA 同步标志（实际调用由主 agent 走 ask-atlassian，脚本只记账）",
      "properties": {
        "fetched": { "type": "boolean" },
        "analysis_comment_added": { "type": "boolean" },
        "conclusion_comment_added": { "type": "boolean" },
        "transition_done": { "type": "boolean" },
        "last_error": { "type": "string" }
      }
    },

    "git": {
      "type": "object",
      "description": "git 提交与 MR 信息",
      "properties": {
        "branch": { "type": "string", "description": "feature-<需求单号>" },
        "commit_sha": { "type": "string" },
        "commit_format": { "type": "string", "description": "feat: NEWNF-XXXXX 【模块】描述" },
        "pr_url": { "type": "string" }
      }
    },

    "worktree": {
      "type": "object",
      "description": "编译机隔离 worktree 登记（worktree-set 命令写入，置位 worktree_ready）",
      "properties": {
        "name": { "type": "string", "description": "feature-<需求单号>" },
        "remote_dir": { "type": "string" },
        "base_branch": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
