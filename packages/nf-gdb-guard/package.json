{
  "name": "@nsfocus/nf-gdb-guard",
  "version": "0.1.0",
  "description": "GDB 危险命令防护插件：在 tools/pre-execute 拦截 Bash/pwsh 中的 gdb 危险命令（continue/run/jump/kill/quit/call 等），替代未接线的 gdb-tools block-gdb-dangerous hook",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT"
}